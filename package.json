{
  "name": "ronengg",
  "version": "1.0.0",
  "private": true,
  "description": "RonenGG link page (GitHub Pages) and the scrapers that keep its leaderboards up to date.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "fetch:kicks": "node scripts/fetch-kicks-leaderboard.js",
    "fetch:subs": "node scripts/fetch-subs-leaderboard.js",
    "test": "node --test tests/unit/*.test.js",
    "test:python": "python3 -m unittest discover -s tests/python",
    "test:e2e": "node --test tests/e2e/*.test.js"
  },
  "dependencies": {
    "puppeteer": "^25.16.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
